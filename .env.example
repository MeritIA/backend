# ---------------------------------------------------------------------------
# MeritIA backend — plantilla de variables de entorno
#
# Copia este archivo a `.env` y rellena los valores. `.env` esta en .gitignore
# y NO debe subirse nunca: es criterio de aceptacion del proyecto.
# Todos los valores de aqui son ficticios y no sirven en ningun entorno real.
# ---------------------------------------------------------------------------

# --- Aplicacion ---
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1

# --- Base de datos (PostgreSQL, un esquema por modulo) ---
DATABASE_HOST=localhost
# MeritIA publica sus servicios en un rango propio (1xxxx): lejos de los
# puertos por defecto de PostgreSQL/Redis/S3, y POR DEBAJO de 49152, porque
# de 49152 para arriba Windows reserva bloques distintos en cada reinicio.
# Si aun asi algo choca, `npm run doctor` dice que puerto y por que.
DATABASE_PORT=15432
DATABASE_USER=meritia
DATABASE_PASSWORD=cambia-esta-clave-en-local
DATABASE_NAME=meritia
DATABASE_SSL=false
# Aplica las migraciones pendientes al arrancar (por omision, si; en pruebas, no).
# MIGRACIONES_AUTOMATICAS=true

# --- Redis: cola de evaluacion y rate limiting ---
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=
# Base logica (0-15). Las pruebas de integracion usan la 1 y la vacian al empezar.
REDIS_DB=0

# --- Cola de evaluacion (paquete 4.1). Todas opcionales. ---
# false en las instancias que solo atienden la API, si hay workers dedicados.
COLA_WORKER_HABILITADO=true
COLA_CONCURRENCIA=2
# Intentos totales y espera base del backoff exponencial (15 s, 30 s, 60 s...).
COLA_REINTENTOS=5
COLA_BACKOFF_MS=15000
# Tiempo maximo por intento contra el servicio de IA.
COLA_TIMEOUT_MS=120000

# --- Almacenamiento de objetos (SeaweedFS en local, S3 en produccion) ---
S3_ENDPOINT=http://localhost:19000
# Solo si el navegador alcanza el almacenamiento por otra direccion que el backend (p. ej. dentro de compose).
# S3_PUBLIC_ENDPOINT=
S3_PORT=19000
S3_CONSOLE_PORT=19001

# --- Documentacion de la API ---
# Publica la interfaz navegable en /api/docs. Por omision, activa fuera de
# produccion y desactivada en produccion: el catalogo de endpoints ayuda a quien
# integra, pero tambien a quien busca superficie de ataque.
SWAGGER_UI_ENABLED=true
S3_ACCESS_KEY=meritia
S3_SECRET_KEY=cambia-esta-clave-en-local
S3_BUCKET=meritia-entregas
S3_REGION=us-east-1

# --- Autenticacion PASETO v4 (Ed25519) ---
# El Plan de Seguridad §2 fija PASETO en lugar de JWT. El par de claves se
# genera aparte y NUNCA se versiona. Rotacion anual o ante sospecha.
PASETO_PRIVATE_KEY=
PASETO_PUBLIC_KEY=
TOKEN_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# --- Cifrado en reposo (AES-256-GCM, formato iv:authTag:ciphertext) ---
# Clave de 32 bytes en hexadecimal. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- CORS: origenes permitidos, separados por coma ---
# Web Angular y esquemas nativos de la APK Capacitor.
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8100,capacitor://localhost,ionic://localhost

# --- Rate limiting en tres capas (Plan de Seguridad §5) ---
THROTTLE_IP_TTL=60
THROTTLE_IP_LIMIT=100
THROTTLE_USER_TTL=60
THROTTLE_USER_LIMIT=200
THROTTLE_LOGIN_TTL=60
THROTTLE_LOGIN_LIMIT=10

# --- Servicio de evaluacion con IA ---
# Se habla con el solo desde el modulo de evaluacion, y de forma asincrona.
# 127.0.0.1 y no localhost: localhost resuelve primero a ::1 (IPv6) y los
# puertos que publica Docker escuchan en IPv4, asi que fetch falla con un
# TypeError que no dice por que.
AI_SERVICE_URL=http://127.0.0.1:13100
AI_SERVICE_API_KEY=
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_RETRIES=3

# --- Alertas de seguridad por correo (paquete 5.5) ---
# Sin SMTP_HOST o sin ALERTAS_DESTINO, las alertas solo se registran en el
# log y se avisa de que no hay canal. El proceso arranca igual.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_DESDE=alertas@meritia.local
# Quien recibe los avisos, separados por coma.
ALERTAS_DESTINO=

# --- Avisos por correo a los candidatos ---
# Cerrar una vacante avisa por correo a quienes participaron (decision del
# 27/10/2026). Arranca APAGADO: SMTP existe arriba para mandar alertas de
# seguridad al equipo, y configurarlo para eso no debe empezar a escribirle a
# candidatos reales de rebote. Se enciende donde el texto este aprobado.
# Con esto en false los avisos se registran igual como pendientes, y el reenvio
# (POST /notificaciones/vacantes/:id/reenviar) los recoge cuando se encienda.
NOTIFICACIONES_A_CANDIDATOS=false

# Red de seguridad: con esto puesto, TODO el correo a candidatos va a esta sola
# direccion con el destinatario real en el cuerpo. Para el primer entorno que
# tenga SMTP de verdad.
CORREO_REDIRECCION=

# Donde entra el candidato a ver su resultado. Si va vacia, el correo no pone
# enlace en vez de inventarse uno.
URL_PLATAFORMA=

# --- Control de admision (P1 de docs/rendimiento.md) ---
# Peticiones en vuelo antes de responder 503 con Retry-After. Pasado el punto
# de caida el backend rendia MENOS con mas carga; esto pone el freno.
# El valor sale de la ley de Little: rendimiento medido x objetivo de p95.
# Al cambiar de maquina, repetir test/carga/barrido.mjs y recalcularlo.
ADMISION_MAXIMO_EN_VUELO=50

# --- Logs ---
LOG_LEVEL=debug
