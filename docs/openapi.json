    "/autenticacion/registro": {
      "post": {
        "description": "Crea una cuenta de candidato. El rol no se puede elegir: el registro publico solo crea candidatos, y enviar un campo `rol` devuelve 400.\n\nLos tokens se entregan segun el campo `cliente`: en **web** (por omision) viajan en cookies HttpOnly y NO aparecen en el cuerpo; en **apk** vienen en el cuerpo para guardarlos en el KeyStore.",
        "operationId": "AutenticacionController_registrar",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistroDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SesionRespuesta"
                }
              }
            }
          },
          "400": {
            "description": "Cuerpo invalido. El detalle viene agrupado por campo."
          },
          "409": {
            "description": "Ya existe una cuenta con ese correo."
          },
          "429": {
            "description": "Limite superado. Ver cabecera Retry-After."
          }
        },
        "summary": "Registra un candidato",
        "tags": [
          "autenticacion"
        ]
      }
    },
    "/autenticacion/login": {
      "post": {
        "description": "Limitado a diez intentos por minuto. La respuesta de error no distingue entre correo inexistente y contrasena incorrecta, para no permitir averiguar que correos estan registrados.\n\nEn **web** el token va en cookie HttpOnly y no es legible desde JavaScript; en **apk** viene en el cuerpo.",
        "operationId": "AutenticacionController_iniciarSesion",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SesionRespuesta"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales invalidas."
          },
          "429": {
            "description": "Limite superado. Ver cabecera Retry-After."
          }
        },
        "summary": "Inicia sesion",
        "tags": [
          "autenticacion"
        ]
      }
    },
    "/autenticacion/renovar": {
      "post": {
        "description": "Entrega un token de acceso nuevo. En **web** el token de renovacion se lee de la cookie y no hay que enviarlo; en **apk** va en el cuerpo. Un token de acceso no sirve aqui.",
        "operationId": "AutenticacionController_renovar",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenovarDto"
