        ]
      }
    },
    "/evaluaciones/entrega/{idEntrega}": {
      "get": {
        "description": "Para el candidato que la entrego o para la empresa dueña de la vacante. Incluye la version de rubrica con la que se califico.",
        "operationId": "EvaluacionesController_deEntrega",
        "parameters": [
          {
            "name": "idEntrega",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluacionRespuesta"
                }
              }
            }
          },
          "404": {
            "description": "No existe, aun no se evalua, o quien pregunta no tiene acceso."
