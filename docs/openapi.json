  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Entorno local de desarrollo"
    }
  ],
  "components": {
    "securitySchemes": {
      "paseto": {
        "scheme": "bearer",
        "bearerFormat": "PASETO",
        "type": "http",
        "description": "Token PASETO v4 obtenido en el inicio de sesion. Se envia como: Authorization: Bearer v4.public..."
      }
    },
    "schemas": {
      "RegistroDto": {
        "type": "object",
        "properties": {
          "correo": {
            "type": "string",
            "example": "candidata@ejemplo.com",
            "maxLength": 254
          },
          "contrasena": {
            "type": "string",
            "example": "una-frase-larga-y-dificil",
            "minLength": 12,
            "maxLength": 128,
            "description": "Minimo 12 caracteres. Se exige longitud antes que simbolos raros: una frase larga resiste mas que \"P@ssw0rd!\"."
          },
          "nombreCompleto": {
            "type": "string",
            "example": "Ana Maria Torres",
            "maxLength": 120
          }
        },
        "required": [
          "correo",
          "contrasena",
          "nombreCompleto"
        ]
      },
      "SesionRespuesta": {
        "type": "object",
        "properties": {
          "tokenDeAcceso": {
            "type": "string",
            "description": "Token PASETO v4 para consumir la API."
          },
          "tokenDeRenovacion": {
            "type": "string",
            "description": "Token para obtener uno de acceso nuevo sin volver a iniciar sesion."
          },
          "expiraEn": {
            "type": "string",
            "description": "Expiracion del token de acceso, en ISO8601."
          },
          "rol": {
            "type": "string",
            "enum": [
              "candidato",
              "reclutador",
              "administrador"
            ]
          },
          "idUsuario": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "tokenDeAcceso",
          "tokenDeRenovacion",
          "expiraEn",
          "rol",
          "idUsuario"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "correo": {
            "type": "string",
            "example": "candidata@ejemplo.com"
          },
          "contrasena": {
            "type": "string",
            "example": "una-frase-larga-y-dificil"
          }
        },
        "required": [
          "correo",
          "contrasena"
        ]
      },
      "RenovarDto": {
        "type": "object",
        "properties": {
          "tokenDeRenovacion": {
            "type": "string",
            "description": "Token de renovacion obtenido al iniciar sesion.",
            "example": "v4.public.eyJzdWIiOiIuLi4ifQ..."
          }
        },
        "required": [
          "tokenDeRenovacion"
        ]
      },
      "CrearVacanteDto": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string",
            "example": "Desarrollador backend junior",
            "maxLength": 160
          },
          "descripcion": {
            "type": "string",
            "example": "Buscamos una persona para el equipo de plataforma...",
            "maxLength": 10000
          },
          "ubicacion": {
            "type": "string",
            "example": "Bogota (hibrido)",
            "maxLength": 120
          }
        },
        "required": [
          "titulo",
          "descripcion"
        ]
      },
      "EditarVacanteDto": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string",
            "maxLength": 160
          },
          "descripcion": {
            "type": "string",
            "maxLength": 10000
          },
          "ubicacion": {
            "type": "object",
            "maxLength": 120,
            "nullable": true
          }
        }
      },
      "AsociarEjerciciosDto": {
        "type": "object",
        "properties": {
          "idsDeEjercicios": {
            "description": "Identificadores de los ejercicios, en el orden en que los vera el candidato. Reemplaza la lista anterior.",
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "idsDeEjercicios"
        ]
      },
      "AsignarCandidatoDto": {
        "type": "object",
        "properties": {
          "idCandidato": {
            "type": "string",
            "format": "uuid",
            "description": "Candidato al que se invita a esta vacante."
          }
        },
        "required": [
          "idCandidato"
        ]
      }
    }
  }
}
