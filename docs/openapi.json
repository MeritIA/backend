              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EvaluacionRespuesta"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "paseto": []
          }
        ],
