                  "$ref": "#/components/schemas/SesionRespuesta"
                }
              }
            }
          },
          "401": {
            "description": "Token de renovacion invalido o vencido."
          }
        },
        "summary": "Renueva la sesion",
        "tags": [
          "autenticacion"
        ]
      }
    },
    "/autenticacion/yo": {
      "get": {
        "description": "Sirve al frontend para saber quien esta autenticado y con que rol. Acepta el token por cabecera Authorization o por la cookie HttpOnly.",
        "operationId": "AutenticacionController_yo",
