        ],
        "summary": "Evaluacion de una entrega",
        "tags": [
          "evaluaciones"
        ]
      }
    },
    "/evaluaciones/{idEntrega}/reintentar": {
      "post": {
        "description": "No consume un intento del candidato: el fallo fue de la evaluacion, no suyo.",
        "operationId": "EvaluacionesController_reintentar",
        "parameters": [
          {
            "name": "idEntrega",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReintentoRespuesta"
